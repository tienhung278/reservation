# Required secrets. Do not provide defaults in production.
JWT_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_GATEWAY_SECRET=replace-with-an-internal-shared-secret
MOCK_STRIPE_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Demo seeded user for local assessment.
DEMO_USERNAME=demo@example.com
DEMO_PASSWORD=password

# Local service URLs for non-Docker development.
AUTH_SERVICE_URL=http://localhost:3001
SEAT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
RABBITMQ_URL=amqp://localhost:5672

# Docker Compose injects each service's DATABASE_URL from its own database URL.
AUTH_DATABASE_URL=postgres://auth:auth@auth-postgres:5432/auth
SEAT_DATABASE_URL=postgres://seat:seat@seat-postgres:5432/seat
PAYMENT_DATABASE_URL=postgres://payment:payment@payment-postgres:5432/payment

# Runtime tuning.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=30
PG_POOL_MAX=10
OUTBOX_BATCH_SIZE=25
OUTBOX_PUBLISH_INTERVAL_MS=1000
HOLD_TTL_SECONDS=900
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH_SIZE=50
SEAT_PRICE_CENTS=5000
WEBHOOK_TOLERANCE_SECONDS=300
RATE_LIMIT_LOGIN_MAX=10
PAYMENT_READY_WAIT_MS=1000
